---
import type { Song } from '../data/songs';
import { formatDuration } from '../data/songs';
import { withBase } from '../utils/base';

interface Props {
  song: Song;
  index: number;
}
const { song, index } = Astro.props;
const idx = String(index + 1).padStart(2, '0');
const src = withBase(`/audio/${song.slug}.mp3`);
---

<div
  class="modal"
  id={`modal-${song.slug}`}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`modal-title-${song.slug}`}
  hidden
>
  <div class="modal-backdrop js-close-modal" tabindex="-1"></div>
  <div class="modal-panel">
    <button class="modal-close js-close-modal" aria-label="Đóng">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>

    <span class="modal-index">HƯỚNG {idx}</span>
    <h2 id={`modal-title-${song.slug}`}>{song.title}</h2>
    <p class="modal-gloss">{song.titleGloss} · {song.genre} · {song.bpm} BPM · {formatDuration(song.durationSeconds)}</p>

    <button
      class="btn btn-primary modal-play js-play"
      data-slug={song.slug}
      data-src={src}
      data-title={song.title}
      data-genre={song.genre}
      data-index={idx}
    >
      <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
      Nghe bản này
    </button>

    <div class="modal-block">
      <span class="label">Lời bài hát</span>
      <p class="modal-lyrics">{song.lyrics}</p>
    </div>
  </div>
</div>
